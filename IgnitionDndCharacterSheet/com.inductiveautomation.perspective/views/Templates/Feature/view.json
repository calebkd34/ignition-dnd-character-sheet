{
  "custom": {},
  "params": {
    "description": "This is a description. This is a description. This is a description. This is a description. This is a description. This is a description. This is a description. ",
    "name": "name",
    "off": 0,
    "on": 1
  },
  "propConfig": {
    "params.description": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.name": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.off": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.on": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 40,
      "width": 700
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Feature Name"
        },
        "position": {
          "basis": "141px"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.name"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "alignVertical": "top",
          "textStyle": {
            "paddingTop": 5
          }
        },
        "type": "ia.display.label"
      },
      {
        "children": [
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\t\n\t# run the payload\n\tpayloads \u003d self.view.params.on if self.props.selected else self.view.params.off\n\t\n\tfor payload in payloads:\n\t\tsystem.perspective.sendMessage(\"write\", payload, scope\u003d\"page\")"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "ToggleSwitch_0"
            },
            "position": {
              "height": 33,
              "width": 51
            },
            "propConfig": {
              "meta.visible": {
                "binding": {
                  "config": {
                    "expression": "{view.params.off}!\u003d0"
                  },
                  "type": "expr"
                }
              }
            },
            "type": "ia.input.toggle-switch"
          },
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\t\n\tsystem.perspective.sendMessage(\"write\", {self.view.params.on}, scope \u003d \"page\")"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "Button"
            },
            "position": {
              "height": 21,
              "width": 42,
              "x": 7,
              "y": 7
            },
            "propConfig": {
              "meta.visible": {
                "binding": {
                  "config": {
                    "expression": "{view.params.off}\u003d0"
                  },
                  "type": "expr"
                },
                "persistent": false
              }
            },
            "props": {
              "text": ""
            },
            "type": "ia.input.button"
          }
        ],
        "meta": {
          "name": "Feature Functionality"
        },
        "position": {
          "basis": "59px"
        },
        "type": "ia.container.coord"
      },
      {
        "meta": {
          "name": "Label",
          "tooltip": {
            "enabled": true,
            "location": "bottom",
            "style": {
              "textAlign": "left"
            },
            "width": 500
          }
        },
        "position": {
          "basis": "312px",
          "grow": 1
        },
        "propConfig": {
          "meta.tooltip.text": {
            "binding": {
              "config": {
                "path": "view.params.description"
              },
              "type": "property"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.description"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "alignVertical": "top",
          "textStyle": {
            "overflow": "hidden",
            "paddingTop": 5,
            "textOverflow": "ellipsis",
            "whiteSpace": "nowrap"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "alignContent": "flex-start",
      "style": {
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
}